{
  "name": "@usagekit/views",
  "version": "0.9.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Pure view models over the Meter: usage, budgets, header status, coverage and exceptions.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@usagekit/core": "0.9.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usagekit/usagekit.git",
    "directory": "packages/views"
  },
  "homepage": "https://usagekit.dev",
  "bugs": {
    "url": "https://github.com/usagekit/usagekit/issues"
  }
}
