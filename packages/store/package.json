{
  "name": "@usagekit/store",
  "version": "0.9.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Atomic store commands, reference store and conformance tests.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "import": "./dist/reference.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@usagekit/core": "0.9.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "vitest": ">=5.0.1 <6",
    "fast-check": ">=4.10.2 <5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "fast-check": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usagekit/usagekit.git",
    "directory": "packages/store"
  },
  "homepage": "https://usagekit.dev",
  "bugs": {
    "url": "https://github.com/usagekit/usagekit/issues"
  }
}
