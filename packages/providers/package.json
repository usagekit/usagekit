{
  "name": "@usagekit/providers",
  "version": "0.12.1",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Provider descriptors, catalog, price tables, extractors, fixtures and probes.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "prepublishOnly": "node ../../scripts/publish-guard.mjs",
    "prepack": "node ../../scripts/package-license.mjs"
  },
  "dependencies": {
    "@usagekit/core": "0.12.1"
  },
  "peerDependencies": {
    "vitest": ">=5.0.1 <6",
    "eslint": ">=9 <11",
    "ai": ">=7 <8"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usagekit/usagekit.git",
    "directory": "packages/providers"
  },
  "homepage": "https://usagekit.dev",
  "bugs": {
    "url": "https://github.com/usagekit/usagekit/issues"
  }
}
