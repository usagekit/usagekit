{
  "name": "usagekit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Local metering, provider administration, headless React UI and durable Postgres storage.",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.3 <11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "setup": "node scripts/check-runtime.mjs && node scripts/install-hooks.mjs",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "registry:build": "node scripts/registry-build.mjs",
    "site:dev": "npm run dev --workspace @usagekit/site",
    "site:build": "npm run build --workspace @usagekit/site",
    "site:preview": "npm run preview --workspace @usagekit/site",
    "preview:build": "node scripts/build-preview.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "check": "npm run check:runtime && npm run check:workspace && npm run check:format && npm run typecheck && npm run test:unit && npm run test:postgres && npm test && npm run test:cloudflare:example && npm run test:cloudflare:remote:local",
    "approve:main": "node scripts/approve-main.mjs",
    "prepublishOnly": "node scripts/publish-guard.mjs",
    "test:unit": "node scripts/test-unit.mjs run",
    "test:postgres": "node scripts/test-postgres.mjs",
    "test:unit:watch": "node scripts/test-unit.mjs",
    "release": "node scripts/release.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "cloudflare:types": "wrangler types examples/cloudflare-worker/worker-configuration.d.ts --config examples/cloudflare-worker/wrangler.jsonc",
    "cloudflare:dev": "wrangler dev --local --config examples/cloudflare-worker/wrangler.jsonc",
    "test:cloudflare:example": "node examples/cloudflare-worker/smoke.mjs",
    "test:cloudflare:remote:local": "node examples/cloudflare-worker/remote/validate-local.mjs",
    "check:consumer": "node scripts/check-consumer.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "ajv": "8.17.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "jsdom": "30.1.1",
    "lucide-react": "1.48.0",
    "prettier": "3.6.2",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "miniflare": "5.20260925.0-alpha",
    "wrangler": "4.141.0",
    "esbuild": "0.28.1",
    "@prisma/client": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "prisma": "7.9.1",
    "@biomejs/biome": "2.5.15"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usagekit/usagekit.git"
  },
  "homepage": "https://usagekit.dev",
  "bugs": {
    "url": "https://github.com/usagekit/usagekit/issues"
  }
}
