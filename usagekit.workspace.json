{
  "schemaVersion": 1,
  "status": "ui-postgres-release-preparation",
  "publication": "restricted-release",
  "projects": [
    {
      "name": "@usagekit/core",
      "path": "packages/core",
      "phase": "foundation",
      "allows": [],
      "purpose": "Exact quantities, ownership and pure domain types.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/store",
      "path": "packages/store",
      "phase": "foundation",
      "allows": ["@usagekit/core"],
      "purpose": "Atomic store commands, reference store and conformance tests.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/meter",
      "path": "packages/meter",
      "phase": "foundation",
      "allows": ["@usagekit/core", "@usagekit/store"],
      "purpose": "Admission, reservations, settlement and recovery.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/store-sqlite",
      "path": "packages/store-sqlite",
      "phase": "local-server",
      "allows": ["@usagekit/core", "@usagekit/store"],
      "purpose": "store-sqlite local server capability.",
      "runtime": "node"
    },
    {
      "name": "@usagekit/http",
      "path": "packages/http",
      "phase": "local-server",
      "allows": ["@usagekit/core", "@usagekit/meter"],
      "purpose": "http local server capability.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/client",
      "path": "packages/client",
      "phase": "local-server",
      "allows": ["@usagekit/core"],
      "purpose": "client local server capability.",
      "runtime": "web",
      "typeAllows": ["@usagekit/http"]
    },
    {
      "name": "@usagekit/server",
      "path": "packages/server",
      "phase": "local-server",
      "allows": [
        "@usagekit/core",
        "@usagekit/store",
        "@usagekit/meter",
        "@usagekit/store-sqlite",
        "@usagekit/http",
        "@usagekit/client",
        "@usagekit/views",
        "@usagekit/react",
        "@usagekit/providers",
        "@usagekit/proxy"
      ],
      "purpose": "server local server capability.",
      "runtime": "node"
    },
    {
      "name": "@usagekit/cli",
      "path": "packages/cli",
      "phase": "local-server",
      "allows": ["@usagekit/core", "@usagekit/client", "@usagekit/server"],
      "purpose": "cli local server capability.",
      "runtime": "node"
    },
    {
      "name": "@usagekit/views",
      "path": "packages/views",
      "phase": "ui",
      "allows": ["@usagekit/core"],
      "purpose": "Pure view models over the Meter for usage, budgets, header status, coverage and exceptions.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/react",
      "path": "packages/react",
      "phase": "ui",
      "allows": ["@usagekit/core", "@usagekit/views"],
      "purpose": "React hooks and a Meter provider over the view models.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/registry",
      "path": "packages/registry",
      "phase": "ui",
      "allows": ["@usagekit/core", "@usagekit/views", "@usagekit/react"],
      "purpose": "shadcn registry blocks for Radix and Base UI, their build and consumer tests. Blocks are web code; the package tooling runs on Node.",
      "runtime": "node"
    },
    {
      "name": "@usagekit/providers",
      "path": "packages/providers",
      "phase": "catalog",
      "allows": ["@usagekit/core"],
      "purpose": "Provider descriptors, catalog, price tables, extractors, fixture harness and balance probes.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/proxy",
      "path": "packages/proxy",
      "phase": "proxy",
      "allows": ["@usagekit/core", "@usagekit/providers"],
      "purpose": "Local provider routing, vault key injection, admission and bounded receipt capture.",
      "runtime": "node"
    },
    {
      "name": "@usagekit/store-d1",
      "path": "packages/store-d1",
      "phase": "cloudflare",
      "allows": ["@usagekit/core", "@usagekit/store"],
      "purpose": "Cloudflare adapter with authoritative SQLite-backed Durable Object storage.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/site",
      "path": "packages/site",
      "phase": "website",
      "allows": [
        "@usagekit/core",
        "@usagekit/store",
        "@usagekit/meter",
        "@usagekit/views",
        "@usagekit/react"
      ],
      "purpose": "Static open-source project website, React library documentation and interactive examples.",
      "runtime": "web"
    },
    {
      "name": "@usagekit/store-postgres",
      "path": "packages/store-postgres",
      "phase": "storage-adapters",
      "allows": ["@usagekit/core", "@usagekit/store"],
      "purpose": "Postgres atomic Store, migrations and transaction-bound host composition.",
      "runtime": "node"
    }
  ],
  "testDependencies": [
    "vitest",
    "fast-check",
    "hono",
    "@usagekit/store",
    "@usagekit/meter",
