    "react-dom",
    "prettier"
  ],
  "publishable": [
    "@usagekit/core",
    "@usagekit/store",
    "@usagekit/meter",
    "@usagekit/providers",
    "@usagekit/views",
    "@usagekit/react",
    "@usagekit/store-postgres"
  ]
}
